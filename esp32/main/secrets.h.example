/* ============================================================
   配置模板 —— 用法：
     1. 把本文件复制成 secrets.h（同目录）
     2. 填入自己的值
   secrets.h 已写在 .gitignore 里，不会提交到 GitHub。
   ============================================================ */
#pragma once

/* WiFi 必须是 2.4GHz！ESP32 不支持 5GHz（5.8G 也连不上） */
#define WIFI_SSID   "YOUR_WIFI_SSID"
#define WIFI_PASS   "YOUR_WIFI_PASSWORD"

/* 运行平台（fastP）那台电脑的局域网 IP
   - 用 ipconfig 查 "无线局域网适配器 WLAN" 下的 IPv4
   - ESP32 和电脑必须在同一个网络（同一热点）下 */
#define SERVER_IP   "192.168.1.100"
